# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files. A .env here would be visible to `next build`, which
# would inline BACKEND_URL at build time and break the runtime value
# Compose passes in - keep this directory free of env files.
.env
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
