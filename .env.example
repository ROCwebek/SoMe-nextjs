# The only env file in this project. Copy to .env before running anything.
# .env is gitignored; this template is committed so everyone knows the names.

# Database credentials. Compose passes these to both the postgres container
# and the backend.
POSTGRES_DB=some
POSTGRES_USER=some
POSTGRES_PASSWORD=some
DB_USER=some
DB_PASSWORD=some
DB_NAME=some

# Used when running the backend directly on your host. Under Docker Compose
# these are ignored - docker-compose.yml sets them to db/5432, the service
# name and port on the internal network.
DB_HOST=localhost
DB_PORT=5432

PORT=3006

# The Next.js server reads this to reach the API. Leave it unset: the code
# defaults to http://localhost:3006, and Compose sets it to
# http://backend:3006 inside the network.
#BACKEND_URL=http://localhost:3006
