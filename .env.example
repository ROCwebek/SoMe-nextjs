# Copy to .env and fill in the values for your machine.
# .env is gitignored; this file is committed so everyone knows which names to set.
#
# docker-compose.yml also reads DB_USER/DB_PASS/DB_NAME from this .env to
# configure the postgres container and the backend service; DB_HOST/DB_PORT
# are set to db/5432 directly in docker-compose.yml and ignored by it.
DB_HOST=localhost
DB_PORT=5432
DB_USER=some
DB_PASS=some
DB_NAME=some
